<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"

    android:layout_height="wrap_content"

    android:layout_margin="8dp"

    app:cardElevation="2dp">

    <LinearLayout

        android:orientation="vertical"

        android:padding="16dp"

        android:layout_width="match_parent"

        android:layout_height="wrap_content">

        <RelativeLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginBottom="8dp">

            <TextView

                android:textSize="16sp"

                android:textStyle="bold"

                android:textColor="@color/primary"

                android:id="@+id/tvClientNameHistory"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="Cliente: Nombre Completo"

                android:layout_alignParentStart="true"/>

            <TextView

                android:textSize="16sp"

                android:textStyle="bold"

                android:textColor="@color/secondary"

                android:id="@+id/tvAmountHistory"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="$1,500.00 USD"

                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <TextView

            android:textSize="14sp"

            android:id="@+id/tvDescriptionHistory"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginBottom="4dp"

            android:text="Descripcion: Solucion Web y SEO"/>

        <TextView

            android:textSize="12sp"

            android:textColor="@color/gray"

            android:id="@+id/tvDateHistory"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginBottom="8dp"

            android:text="Fecha: 01/01/2025"/>

        <TextView

            android:textSize="12sp"

            android:textColor="@color/gray"

            android:id="@+id/tvClientPhoneHistory"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginBottom="16dp"

            android:text="Telefono: 55-5555-5555"/>

        <Button

            android:textSize="14sp"

            android:id="@+id/btnResendQuote"

            android:paddingTop="8dp"

            android:paddingBottom="8dp"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:text="Reenviar Cotizaci��n R��pida"

            android:backgroundTint="@color/secondary"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
