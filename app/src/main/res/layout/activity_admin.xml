<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    android:background="@color/background"

    android:padding="16dp"

    android:layout_width="match_parent"

    android:layout_height="match_parent">

    <LinearLayout

        android:orientation="vertical"

        android:layout_width="match_parent"

        android:layout_height="wrap_content">

        <TextView

            android:textSize="24sp"

            android:textStyle="bold"

            android:gravity="center"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginBottom="24dp"

            android:text="Administracion de Archivos"/>

        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginBottom="16dp"

            android:elevation="4dp">

            <LinearLayout

                android:orientation="vertical"

                android:padding="16dp"

                android:layout_width="match_parent"

                android:layout_height="wrap_content">

                <TextView

                    android:textSize="18sp"

                    android:textStyle="bold"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginBottom="8dp"

                    android:text="Tarjeta Digital"/>

                <TextView

                    android:textColor="@color/gray"

                    android:id="@+id/tvCardPath"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginBottom="16dp"

                    android:text="No configurado"/>

                <Button

                    android:id="@+id/btnUpdateCard"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:text="Actualizar Tarjeta Digital"

                    android:backgroundTint="@color/primary"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginBottom="16dp"

            android:elevation="4dp">

            <LinearLayout

                android:orientation="vertical"

                android:padding="16dp"

                android:layout_width="match_parent"

                android:layout_height="wrap_content">

                <TextView

                    android:textSize="18sp"

                    android:textStyle="bold"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginBottom="8dp"

                    android:text="Infografia"/>

                <TextView

                    android:textColor="@color/gray"

                    android:id="@+id/tvInfographicPath"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginBottom="16dp"

                    android:text="No configurado"/>

                <Button

                    android:id="@+id/btnUpdateInfographic"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:text="Actualizar Infografia"

                    android:backgroundTint="@color/primary"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginBottom="16dp"

            android:elevation="4dp">

            <LinearLayout

                android:orientation="vertical"

                android:padding="16dp"

                android:layout_width="match_parent"

                android:layout_height="wrap_content">

                <TextView

                    android:textSize="18sp"

                    android:textStyle="bold"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginBottom="8dp"

                    android:text="Soluciones"/>

                <TextView

                    android:textColor="@color/gray"

                    android:id="@+id/tvSolutionsPath"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginBottom="16dp"

                    android:text="No configurado"/>

                <Button

                    android:id="@+id/btnUpdateSolutions"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:text="Actualizar Soluciones"

                    android:backgroundTint="@color/primary"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
