<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:gravity="center_vertical"

    android:orientation="horizontal"

    android:background="@drawable/bottom_border_gray"

    android:paddingTop="8dp"

    android:paddingBottom="8dp"

    android:layout_width="match_parent"

    android:layout_height="wrap_content">

    <TextView

        android:textSize="14sp"

        android:textColor="@color/black"

        android:id="@+id/tvPartidaQuantity"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="1x"

        android:layout_marginEnd="16dp"/>

    <TextView

        android:textSize="14sp"

        android:textColor="@color/black"

        android:id="@+id/tvPartidaDescription"

        android:layout_width="0dp"

        android:layout_height="wrap_content"

        android:text="C��maras de Seguridad IP"

        android:layout_weight="1"

        android:paddingEnd="8dp"/>

    <TextView

        android:textSize="14sp"

        android:textStyle="bold"

        android:textColor="@color/secondary"

        android:id="@+id/tvPartidaAmount"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="$5,000.00"/>

    <ImageView

        android:id="@+id/imgDeletePartida"

        android:padding="4dp"

        android:layout_width="24dp"

        android:layout_height="24dp"

        android:src="@drawable/ic_delete"

        android:contentDescription="Eliminar Partida"

        android:layout_marginStart="16dp"/>

</LinearLayout>
